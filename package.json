{
  "name": "@keenmate/web-daterangepicker",
  "version": "2.0.0-rc05",
  "description": "Lightweight date picker web component with excellent keyboard navigation and range selection",
  "type": "module",
  "main": "./dist/web-daterangepicker.umd.js",
  "module": "./dist/web-daterangepicker.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "customElements": "custom-elements.json",
  "web-types": "web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-daterangepicker.js",
      "require": "./dist/web-daterangepicker.umd.js",
      "default": "./dist/web-daterangepicker.js"
    },
    "./style.css": "./dist/style.css",
    "./css": "./src/css/main.css",
    "./css/variables": "./src/css/variables.css",
    "./css/base": "./src/css/base.css",
    "./dist/*": "./dist/*",
    "./src/css/*": "./src/css/*",
    "./package.json": "./package.json",
    "./component-variables.manifest.json": "./component-variables.manifest.json"
  },
  "sideEffects": [
    "./dist/web-daterangepicker.js",
    "./dist/web-daterangepicker.umd.js",
    "*.css"
  ],
  "files": [
    "dist",
    "src/css",
    "component-variables.manifest.json",
    "custom-elements.json",
    "web-types.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json"
  ],
  "scripts": {
    "dev": "vite",
    "analyze": "cem analyze",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "build": "npm run clean:dist && npm run analyze && npm run docs:api && vite build && tsc",
    "build:types": "tsc",
    "build:full": "vite build && tsc",
    "preview": "vite preview",
    "package": "npm run build && npm pack",
    "publish:dry": "npm run build && npm publish --dry-run",
    "clean": "rimraf dist *.tgz",
    "clean:dist": "rimraf dist",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "keywords": [
    "datepicker",
    "web-daterangepicker",
    "daterangepicker",
    "date-picker",
    "web-component",
    "web-components",
    "custom-element",
    "custom-elements",
    "calendar",
    "date-input",
    "date-selector",
    "keenmate"
  ],
  "author": "Keenmate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/web-daterangepicker.git"
  },
  "homepage": "https://web-daterangepicker.keenmate.dev",
  "bugs": {
    "url": "https://github.com/keenmate/web-daterangepicker/issues"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.60.0",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "dependencies": {
    "@keenmate/web-components-core": "file:../web-components-core"
  }
}
